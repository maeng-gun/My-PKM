{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "My-PKM Canvas Specification Schema",
  "description": "Intermediate semantic specification generated by LLM (Step 2) and consumed by canvas_compiler.py (Step 3).",
  "type": "object",
  "required": [
    "topic",
    "canvas_filename",
    "master_briefing",
    "groups",
    "nodes",
    "edges"
  ],
  "properties": {
    "topic": {
      "type": "string",
      "description": "캔버스 주제명 (예: AI CAPEX와 전력 인프라 병목)"
    },
    "canvas_filename": {
      "type": "string",
      "description": "700. utilize/ 에 저장할 캔버스 파일명 (예: Canvas_AI_CAPEX와_전력_인프라_병목.canvas)"
    },
    "master_briefing": {
      "type": "object",
      "required": ["title", "summary_lines"],
      "properties": {
        "title": {
          "type": "string",
          "description": "캔버스 최상단 마스터 브리핑 제목"
        },
        "summary_lines": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2,
          "maxItems": 6,
          "description": "캔버스 전체 맥락을 관통하는 3~4줄 핵심 요약 불릿"
        }
      }
    },
    "groups": {
      "type": "array",
      "description": "Lv3/Lv4 코어 위키들을 소주제별로 묶는 X축 수평 그룹 컨테이너 목록",
      "items": {
        "type": "object",
        "required": ["group_id", "label", "order_x"],
        "properties": {
          "group_id": {
            "type": "string",
            "description": "그룹 고유 식별자 (예: grp_macro, grp_infra)"
          },
          "label": {
            "type": "string",
            "description": "그룹 프레임 상단 라벨"
          },
          "color": {
            "type": "string",
            "enum": ["1", "2", "3", "4", "5", "6"],
            "description": "JSON Canvas 표준 컬러 코드 (1:Red, 2:Orange, 3:Yellow, 4:Green, 5:Cyan, 6:Purple)"
          },
          "order_x": {
            "type": "integer",
            "description": "좌측부터 배치할 그룹의 수평 순서 (0, 1, 2...)"
          },
          "briefing": {
            "type": "string",
            "description": "그룹 상단에 배치할 3~4줄 요약 text 카드 본문"
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "description": "캔버스에 배치할 볼트 내 마크다운 파일 노드 목록",
      "items": {
        "type": "object",
        "required": ["node_id", "note_title", "swimlane", "role"],
        "properties": {
          "node_id": {
            "type": "string",
            "description": "노드 참조용 로컬 식별자 (edges에서 참조)"
          },
          "note_title": {
            "type": "string",
            "description": "볼트 내 노트 파일명(확장자 제외) 또는 별칭(aliases)"
          },
          "file_path": {
            "type": "string",
            "description": "볼트 루트 상대 경로 (예: 400. Wiki/기업_SK하이닉스(000660).md)"
          },
          "swimlane": {
            "type": "string",
            "enum": ["Lv1", "Lv2", "Lv3", "Lv4", "Source"],
            "description": "수직 스윔레인 계층 (Top-to-Bottom: Lv1 ➔ Lv2 ➔ Lv3 ➔ Lv4 ➔ Source)"
          },
          "group_id": {
            "type": ["string", "null"],
            "description": "소속 소주제 그룹 ID (Lv3, Lv4 위키에 주로 부여, Lv1/Lv2 및 Source는 null 가능)"
          },
          "role": {
            "type": "string",
            "enum": ["seed", "lineage_ancestor", "core_wiki", "source_leaf"],
            "description": "노드 역할 (seed: 출발 핵심 위키, lineage_ancestor: 상향 직계 조상, core_wiki: 연관 위키, source_leaf: 100·200·300 원천 메모)"
          },
          "subpath": {
            "type": "string",
            "description": "#섹션헤딩 형식의 포커싱 서브패스 (예: #1. 핵심 정의 및 프레임워크)"
          },
          "color": {
            "type": "string",
            "enum": ["1", "2", "3", "4", "5", "6"]
          },
          "order_in_row": {
            "type": "integer",
            "default": 0,
            "description": "동일 그룹 및 동일 스윔레인 내에서의 좌우 배치 순서"
          },
          "anchor_node_id": {
            "type": ["string", "null"],
            "description": "Source 리프 노드가 직하단에 정렬될 기준 상위 위키 node_id"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "description": "노드 간 시맨틱 연결선 목록",
      "items": {
        "type": "object",
        "required": ["from_node", "to_node", "relation_type", "label"],
        "properties": {
          "from_node": {
            "type": "string",
            "description": "출발 node_id"
          },
          "to_node": {
            "type": "string",
            "description": "도착 node_id"
          },
          "relation_type": {
            "type": "string",
            "enum": ["hierarchy", "related", "prev", "source", "strategy_pull"],
            "description": "관계 유형 (hierarchy: 상하위계 Lv1➔Lv4, related: 수평 연관 ↔, prev: 시계열 선후, source: 원천 근거 Source➔Lv4, strategy_pull: 포트폴리오 전략 롤업)"
          },
          "label": {
            "type": "string",
            "maxLength": 20,
            "description": "15자 이내 시맨틱 엣지 라벨"
          },
          "color": {
            "type": "string",
            "enum": ["1", "2", "3", "4", "5", "6"]
          }
        }
      }
    }
  }
}
